#!/usr/bin/env bash
set -Eeuo pipefail

readonly PINNED_KRATOS_VERSION="kratos version v3.0.0"
readonly PINNED_KRATOS_MODULE="github.com/go-kratos/kratos/cmd/kratos/v3@v3.0.0-20260626125723-668db92c2c00"
readonly PINNED_BUF_VERSION="1.60.0"
readonly PINNED_BUF_MODULE="github.com/bufbuild/buf@v1.60.0"
readonly UPSTREAM_LAYOUT_TAG="v3.0.0"
readonly UPSTREAM_LAYOUT_COMMIT="94dbfcc4264a6be8e7b6c4929923c1e1f738b980"
readonly UPSTREAM_NOTICE_SHA256="3b44929bdd575a570c42165d4fd4eac57a5055745d2ecf3f121aa6a084cf9230"
readonly MODULE_PREFIX="github.com/zhangzhe-ctrl/"
readonly GENERATOR_BRANCH="layout-input"

usage() {
  cat <<'EOF'
Usage: scripts/new-service <module-path> [--parent <existing-directory>]

Example:
  scripts/new-service github.com/zhangzhe-ctrl/ani-notification-service \
    --parent /home/chabking/workspace
EOF
}

die() {
  printf 'new-service: %s\n' "$*" >&2
  exit 1
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
    return
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
    return
  fi
  die "sha256sum or shasum is required"
}

rg_quiet() {
  local rg_status
  set +e
  rg --quiet "$@"
  rg_status=$?
  set -e
  case $rg_status in
    0) return 0 ;;
    1) return 1 ;;
    *) die "rg failed while validating generated output (status $rg_status)" ;;
  esac
}

collect_rg_files() {
  local output_file=$1
  shift
  local rg_status
  set +e
  rg --files-with-matches --null "$@" >"$output_file"
  rg_status=$?
  set -e
  case $rg_status in
    0 | 1) return 0 ;;
    *) die "rg failed while selecting generated files (status $rg_status)" ;;
  esac
}

[[ $# -gt 0 ]] || { usage >&2; exit 2; }
if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  usage
  exit 0
fi

module=$1
shift
parent=$PWD
while [[ $# -gt 0 ]]; do
  case "$1" in
    --parent)
      [[ $# -ge 2 ]] || die "--parent requires a value"
      parent=$2
      shift 2
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ $module =~ ^github\.com/zhangzhe-ctrl/[a-z0-9][a-z0-9-]*$ ]] || \
  die "module path must match ${MODULE_PREFIX}<lowercase-service-name>"
service=${module##*/}
[[ $service =~ ^[a-z0-9][a-z0-9-]*$ ]] || \
  die "service name must contain only lowercase letters, digits, and hyphens"

command -v git >/dev/null 2>&1 || die "git is required"
command -v go >/dev/null 2>&1 || die "go is required"
command -v rg >/dev/null 2>&1 || die "rg is required"
command -v mv >/dev/null 2>&1 || die "mv is required"
[[ -d $parent ]] || die "parent directory does not exist: $parent"
parent=$(cd "$parent" && pwd -P)
target=$parent/$service
[[ ! -e $target && ! -L $target ]] || die "target already exists: $target"

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
layout_root=$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null) || \
  die "layout checkout is not a Git repository"
layout_branch=$(git -C "$layout_root" symbolic-ref --quiet --short HEAD 2>/dev/null) || \
  die "layout checkout must be on a symbolic branch"
layout_commit=$(git -C "$layout_root" rev-parse --verify HEAD 2>/dev/null) || \
  die "layout checkout has no commit"
layout_status=$(git -C "$layout_root" status --porcelain --untracked-files=all) || \
  die "cannot inspect layout checkout status"
[[ -z $layout_status ]] || die "layout checkout must be clean"

kratos_bin=${KRATOS_BIN:-}
if [[ -z $kratos_bin ]]; then
  set +e
  kratos_bin=$(command -v kratos 2>/dev/null)
  command_status=$?
  set -e
  [[ $command_status -eq 0 ]] || kratos_bin=
fi
[[ -n $kratos_bin && -x $kratos_bin ]] || die "pinned kratos CLI is required"
kratos_bin=$(cd "$(dirname "$kratos_bin")" && pwd -P)/$(basename "$kratos_bin")
actual_version=$("$kratos_bin" -v 2>&1) || die "cannot read kratos CLI version"
[[ $actual_version == "$PINNED_KRATOS_VERSION" ]] || \
  die "kratos CLI version mismatch: got '$actual_version'"
actual_module=$(go version -m "$kratos_bin" | awk '$1 == "mod" {print $2 "@" $3; exit}') || \
  die "cannot inspect kratos CLI module"
[[ $actual_module == "$PINNED_KRATOS_MODULE" ]] || \
  die "kratos CLI module mismatch: got '$actual_module'"
kratos_sha256=$(sha256_file "$kratos_bin")

buf_bin=${BUF_BIN:-$layout_root/.tools/bin/buf}
if [[ ! -x $buf_bin && -z ${BUF_BIN:-} ]]; then
  set +e
  buf_bin=$(command -v buf 2>/dev/null)
  command_status=$?
  set -e
  [[ $command_status -eq 0 ]] || buf_bin=
fi
[[ -n $buf_bin && -x $buf_bin ]] || die "pinned buf CLI is required; run 'make tools'"
buf_bin=$(cd "$(dirname "$buf_bin")" && pwd -P)/$(basename "$buf_bin")
actual_buf_version=$("$buf_bin" --version 2>&1) || die "cannot read buf CLI version"
[[ $actual_buf_version == "$PINNED_BUF_VERSION" ]] || \
  die "buf CLI version mismatch: got '$actual_buf_version'"
actual_buf_module=$(go version -m "$buf_bin" | awk '$1 == "mod" {print $2 "@" $3; exit}') || \
  die "cannot inspect buf CLI module"
[[ $actual_buf_module == "$PINNED_BUF_MODULE" ]] || \
  die "buf CLI module mismatch: got '$actual_buf_module'"
buf_sha256=$(sha256_file "$buf_bin")

scratch=$(mktemp -d "$parent/.${service}.ani-layout.XXXXXX")
user_home_dir=$(cd ~ && pwd -P)
cache_parent=$user_home_dir/.kratos/repo/$(basename "$scratch")
cache_checkout=$cache_parent/layout-source@$GENERATOR_BRANCH
cache_owned=0

cleanup() {
  if [[ ${cache_owned:-0} -eq 1 && -n ${cache_parent:-} && -d $cache_parent ]]; then
    case $cache_parent in
      "$user_home_dir/.kratos/repo/.${service}.ani-layout."*) rm -rf -- "$cache_parent" ;;
      *) printf 'new-service: refusing unexpected cache cleanup path: %s\n' "$cache_parent" >&2 ;;
    esac
  fi
  if [[ -n ${scratch:-} && -d $scratch ]]; then
    case $scratch in
      "$parent/.${service}.ani-layout."*) rm -rf -- "$scratch" ;;
      *) printf 'new-service: refusing unexpected scratch cleanup path: %s\n' "$scratch" >&2 ;;
    esac
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

[[ ! -e $cache_parent && ! -L $cache_parent ]] || die "private Kratos cache path already exists"
mkdir -p "$cache_parent" || die "cannot create private Kratos cache namespace"
cache_owned=1
source_checkout=$scratch/layout-source
git clone --quiet --single-branch --branch "$layout_branch" "file://$layout_root" "$source_checkout" || \
  die "cannot create immutable layout source checkout"
git -C "$source_checkout" branch --move "$GENERATOR_BRANCH" || \
  die "cannot normalize the private generator branch"
source_commit=$(git -C "$source_checkout" rev-parse --verify HEAD) || \
  die "cannot inspect layout source commit"
source_status=$(git -C "$source_checkout" status --porcelain --untracked-files=all) || \
  die "cannot inspect layout source status"
[[ $source_commit == "$layout_commit" && -z $source_status ]] || \
  die "layout source checkout does not match the clean candidate commit"

generated=$scratch/$service
generator_log=$scratch/kratos-new.log
set +e
"$kratos_bin" new "$generated" \
  --repo "file://$source_checkout" \
  --branch "$GENERATOR_BRANCH" \
  --timeout 120s >"$generator_log" 2>&1
generator_status=$?
set -e
"$source_checkout/scripts/check-generator-result" "$generator_status" "$generator_log" || \
  die "official kratos generator failed"

cache_commit=$(git -C "$cache_checkout" rev-parse --verify HEAD 2>/dev/null) || \
  die "cannot inspect private Kratos cache commit"
cache_branch=$(git -C "$cache_checkout" symbolic-ref --quiet --short HEAD 2>/dev/null) || \
  die "private Kratos cache is detached"
cache_status=$(git -C "$cache_checkout" status --porcelain --untracked-files=all) || \
  die "cannot inspect private Kratos cache status"
cache_origin=$(git -C "$cache_checkout" remote get-url origin) || \
  die "cannot inspect private Kratos cache origin"
[[ $cache_commit == "$layout_commit" && $cache_branch == "$GENERATOR_BRANCH" && -z $cache_status ]] || \
  die "private Kratos cache does not match the layout candidate"
[[ $cache_origin == "file://$source_checkout" ]] || die "private Kratos cache origin mismatch"

layout_commit_after=$(git -C "$layout_root" rev-parse --verify HEAD) || \
  die "cannot re-check layout commit"
layout_status_after=$(git -C "$layout_root" status --porcelain --untracked-files=all) || \
  die "cannot re-check layout status"
[[ $layout_commit_after == "$layout_commit" ]] || die "layout commit changed during generation"
[[ -z $layout_status_after ]] || die "layout checkout changed during generation"
[[ -f $generated/go.mod ]] || die "generator did not create go.mod"

generated_module=$(awk '$1 == "module" {print $2; exit}' "$generated/go.mod")
[[ $generated_module == "$service" ]] || \
  die "unexpected module emitted by kratos CLI: $generated_module"

# The pinned CLI intentionally excludes .github. Restore it from the immutable
# source checkout before removing layout-only material.
cp -R "$source_checkout/.github" "$generated/.github"
cp "$generated/templates/service/README.md" "$generated/README.md"
cp "$generated/templates/service/AGENTS.md" "$generated/AGENTS.md"
rm -rf -- "$generated/templates" "$generated/docs/scaffold"
rm -f -- \
  "$generated/docs/LAYOUT-0.md" \
  "$generated/scripts/check-generator-result" \
  "$generated/scripts/new-service" \
  "$generated/scripts/verify-layout" \
  "$generated/.github/workflows/layout.yml"

(cd "$generated" && go mod edit -module "$module")
# The official generator rewrites this layout's module to the service basename.
# Rewrite only imports/go_package values that point at the layout-owned internal
# tree. A bare "$service/" replacement would corrupt standard-library imports
# for valid names such as "go" (for example, go/parser and go/token).
old_owned_prefix="\"$service/internal/"
new_owned_prefix="\"$module/internal/"
collect_rg_files "$scratch/import-files" --fixed-strings "$old_owned_prefix" \
  --glob '*.go' --glob '*.proto' --glob '!**/*.pb.go' "$generated"
while IFS= read -r -d '' file; do
  sed -i "s|$old_owned_prefix|$new_owned_prefix|g" "$file"
done <"$scratch/import-files"
collect_rg_files "$scratch/name-files" --hidden --fixed-strings 'ani-service-template' \
  --glob '!.git/**' --glob '!**/*.pb.go' "$generated"
while IFS= read -r -d '' file; do
  sed -i "s|ani-service-template|$service|g" "$file"
done <"$scratch/name-files"
collect_rg_files "$scratch/module-files" --hidden --fixed-strings '__SERVICE_MODULE__' \
  --glob '!.git/**' --glob '!**/*.pb.go' "$generated"
while IFS= read -r -d '' file; do
  sed -i "s|__SERVICE_MODULE__|$module|g" "$file"
done <"$scratch/module-files"
sed -i "s|cmd/server|cmd/$service|g" \
  "$generated/docs/runtime.md" "$generated/docs/runtime-verification.md"

# Never edit generated protobuf descriptors as text. Normalize the source Proto
# first, then regenerate with the pinned Buf/protoc-gen-go pipeline.
(cd "$generated" && GOWORK=off "$buf_bin" lint)
(cd "$generated" && GOWORK=off "$buf_bin" build)
(cd "$generated" && GOWORK=off "$buf_bin" generate --template buf.gen.yaml)

mkdir -p "$generated/docs/scaffold"
{
  printf '# Scaffold provenance\n\n'
  printf -- '- target module: `%s`\n' "$module"
  printf -- '- service name: `%s`\n' "$service"
  printf -- '- layout module: `github.com/zhangzhe-ctrl/ani-kratos-layout`\n'
  printf -- '- layout branch: `%s`\n' "$layout_branch"
  printf -- '- layout commit: `%s`\n' "$layout_commit"
  printf -- '- upstream layout: `github.com/go-kratos/kratos-layout@%s`\n' "$UPSTREAM_LAYOUT_TAG"
  printf -- '- upstream layout commit: `%s`\n' "$UPSTREAM_LAYOUT_COMMIT"
  printf -- '- Kratos CLI version: `%s`\n' "$PINNED_KRATOS_VERSION"
  printf -- '- Kratos CLI module: `%s`\n' "$PINNED_KRATOS_MODULE"
  printf -- '- Kratos CLI binary SHA-256: `%s`\n' "$kratos_sha256"
  printf -- '- Buf version: `%s`\n' "$PINNED_BUF_VERSION"
  printf -- '- Buf module: `%s`\n' "$PINNED_BUF_MODULE"
  printf -- '- Buf binary SHA-256: `%s`\n' "$buf_sha256"
  printf '\nNo timestamp is recorded so equal inputs remain reproducible.\n'
} >"$generated/docs/scaffold/provenance.md"

[[ -f $generated/cmd/$service/main.go ]] || die "generated command was not renamed"
[[ -f $generated/.github/workflows/ci.yml ]] || die "generated CI workflow is missing"
[[ -f $generated/THIRD_PARTY_NOTICES.go-kratos-layout.txt ]] || \
  die "upstream Kratos layout notice is missing"
[[ $(sha256_file "$generated/THIRD_PARTY_NOTICES.go-kratos-layout.txt") == \
  "$UPSTREAM_NOTICE_SHA256" ]] || die "upstream Kratos layout notice was modified"
[[ ! -e $generated/LICENSE ]] || die "generated service must choose its own project license"
normalized_module=$(awk '$1 == "module" {print $2; exit}' "$generated/go.mod")
[[ $normalized_module == "$module" ]] || die "generated module path was not normalized"

reject_generated_residue() {
  local needle=$1
  if rg_quiet --hidden --fixed-strings --glob '!**/.git/**' \
    --glob '!**/docs/scaffold/provenance.md' "$needle" "$generated"; then
    rg --line-number --hidden --fixed-strings --glob '!**/.git/**' \
      --glob '!**/docs/scaffold/provenance.md' "$needle" "$generated" >&2
    die "generated service contains template residue: $needle"
  fi
}

reject_generated_residue '__SERVICE_MODULE__'
if [[ $module != "github.com/zhangzhe-ctrl/ani-kratos-layout" ]]; then
  reject_generated_residue 'github.com/zhangzhe-ctrl/ani-kratos-layout'
fi
if [[ $service != "ani-service-template" ]]; then
  reject_generated_residue 'ani-service-template'
fi
[[ ! -d $generated/api ]] || die "generated service contains a sample business API"
if rg_quiet --line-number --glob '*.go' --glob '*.proto' \
  'api/todo/|Todo(Service|Request|Reply)|NewTodo' "$generated"; then
  die "generated service contains the removed Todo sample domain"
fi
[[ ! -e $generated/go.work && ! -e $generated/.gitmodules ]] || \
  die "generated service contains a workspace or submodule binding"
if rg_quiet '^[[:space:]]*replace([[:space:](]|$)' "$generated/go.mod"; then
  die "generated go.mod contains a replace directive"
fi

git -C "$generated" init --quiet --initial-branch=main
generated_remotes=$(git -C "$generated" remote) || die "cannot inspect generated Git remotes"
[[ -z $generated_remotes ]] || die "generated repository unexpectedly has a remote"
[[ ! -e $target && ! -L $target ]] || die "target appeared during generation: $target"
mv --no-clobber --no-target-directory -- "$generated" "$target" || \
  die "cannot materialize generated service without replacing the destination"
[[ ! -e $generated && -d $target && -d $target/.git ]] || \
  die "target appeared during atomic materialization: $target"
printf 'created %s at %s\n' "$module" "$target"
